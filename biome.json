{
	"$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
	"organizeImports": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noParameterAssign": "info"
			},
			"complexity": {
				"noStaticOnlyClass": "info"
			},
			"performance": {
				"noAccumulatingSpread": "info"
			},
			"a11y": {
				"useValidAnchor": "info",
				"useKeyWithClickEvents": "info",
				"noSvgWithoutTitle": "info"
			}
		}
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git"
	}
}
